let allProducts = [];
let currentCategory = 'all';
let cart = [];

// Завантажуємо товари з твого products.json
fetch('products.json')
    .then((res) => res.json())
    .then((data) => {
        allProducts = data;
        renderProducts(allProducts);
    })
    .catch(() => {
        const container = document.getElementById('products-container');
        if (container) {
            container.innerHTML = `<p style="color: #555; text-align: center;">Помилка завантаження каталогу</p>`;
        }
    });
